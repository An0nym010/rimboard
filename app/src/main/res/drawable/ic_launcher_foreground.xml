<?xml version="1.0" encoding="utf-8"?>
<!--
    The adaptive icon's foreground: the shared keyboard symbol with the
    flavour's word under it.

    A layer list rather than one vector so the symbol is authored once. Which
    word arrives depends on the variant being built — ic_launcher_wordmark is
    supplied by src/offline and src/online and by nothing else.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_symbol" />
    <item android:drawable="@drawable/ic_launcher_wordmark" />
</layer-list>
