    <!--
        Network: the first-run choice, and the screen that backs it with evidence.

        English-only on purpose, and suppressed one string at a time rather
        than on the <resources> tag so every other string in the app is still
        checked. This block is the text someone reads while deciding whether
        their keystrokes may leave the device; a machine translation that
        softens "sent to the service that answers them" is worse than showing
        an English sentence the reader can tell is English. They need a native
        speaker before they get values-de and friends.
    -->
    <string name="net_choice_title" tools:ignore="MissingTranslation">Choose how RimBoard connects</string>
    <string name="net_choice_offline_head" tools:ignore="MissingTranslation">Stay fully offline</string>
    <string name="net_choice_offline_body" tools:ignore="MissingTranslation">• Nothing you type can leave this device.\n• No accounts, no API keys, nothing to set up.\n• No GIF search, and no AI translation or rewriting.</string>
    <string name="net_choice_online_head" tools:ignore="MissingTranslation">Turn on online features</string>
    <string name="net_choice_online_body" tools:ignore="MissingTranslation">These are the only things RimBoard uses the network for:
• GIF and sticker search.
• Translating or proofreading text you select.

Your search words or selected text go to the service that answers them. Nothing is sent in the background, in incognito, or in a password field. You supply your own API key.</string>
    <string name="net_choice_footer" tools:ignore="MissingTranslation">You can change this any time in Settings → Network.</string>
    <string name="net_choice_pick_offline" tools:ignore="MissingTranslation">Stay offline</string>
    <string name="net_choice_pick_online" tools:ignore="MissingTranslation">Enable online</string>

    <string name="net_offline_build_title" tools:ignore="MissingTranslation">This is the offline build</string>
    <string name="net_offline_build_body" tools:ignore="MissingTranslation">This build has no internet permission, so Android will not let RimBoard connect at all. Nothing you type can leave this device.</string>
    <string name="net_show_proof" tools:ignore="MissingTranslation">Show me</string>
