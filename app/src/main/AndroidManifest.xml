<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- VIBRATE, for key-press haptics, is the only permission every build of
         RimBoard requests. It grants no access to any data.

         INTERNET is deliberately NOT here. The `online` flavor adds it from
         src/online/AndroidManifest.xml; the `offline` flavor has no manifest
         of its own, so its APK carries no network permission and the kernel
         refuses it a socket regardless of what the code above asks for. Keep
         it that way: moving the permission into this file would silently give
         network access to the build whose whole purpose is not having it. -->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        From API 30 an app sees no other packages unless it declares which it
        cares about, and that filtering applies to queryIntentActivities too.
        Without this the keyboard could not tell whether a translator was
        installed even on a phone with one, so the 🌍 fallback had no way to
        know it was about to do nothing.

        This grants visibility of apps handling these two actions and nothing
        else — it is not the broad QUERY_ALL_PACKAGES permission, and it reads
        no package list.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>

    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RimBoard">

        <service
            android:name=".RimBoardService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".setup.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".settings.PersonalDictActivity"
            android:exported="false"
            android:label="@string/pref_personal_dict_title" />

        <activity
            android:name=".settings.ShortcutsActivity"
            android:exported="false"
            android:label="@string/pref_shortcuts_title" />

        <activity
            android:name=".settings.StatsActivity"
            android:exported="false"
            android:label="@string/pref_stats_title" />

        <activity
            android:name=".settings.ToolbarPickerActivity"
            android:exported="false"
            android:label="@string/pref_toolbar_title" />

        <activity
            android:name=".settings.NetworkActivity"
            android:exported="false"
            android:label="@string/pref_network_title" />

        <activity
            android:name=".settings.BackgroundCropActivity"
            android:exported="false"
            android:label="@string/pref_bg_image_title" />

    </application>

</manifest>
