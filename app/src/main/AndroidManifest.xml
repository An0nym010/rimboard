<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- VIBRATE, for key-press haptics, is the only permission every build of
         RimBoard requests. It grants no access to any data.

         INTERNET is deliberately NOT here. The `online` flavor adds it from
         src/online/AndroidManifest.xml; the `offline` flavor has no manifest
         of its own, so its APK carries no network permission and the kernel
         refuses it a socket regardless of what the code above asks for. Keep
         it that way: moving the permission into this file would silently give
         network access to the build whose whole purpose is not having it. -->

    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
        From API 30 an app sees no other packages unless it declares which it
        cares about, and that filtering applies to queryIntentActivities too.
        Without this the keyboard could not tell whether a translator was
        installed even on a phone with one, so the 🌍 fallback had no way to
        know it was about to do nothing.

        The first two entries grant visibility of apps handling those actions
        and nothing else. None of this is the QUERY_ALL_PACKAGES permission:
        the built APK still declares only VIBRATE, which `aapt dump permissions`
        will show.

        The launcher entry is broader and is here for the per-app tint, which
        reads the current app's icon to take its colour. Be clear about what it
        costs: it makes every app with a launcher icon visible to this process,
        so the keyboard *could* enumerate what you have installed. Two things
        bound that, and only the first is enforced by the machine:

        - The offline build holds no INTERNET permission, so nothing it learns
          can leave the device by any route at all.
        - The "App colours" setting decides which packages are actually read.
          It defaults to all of them. It defaulted to about forty well-known
          ones (AppPalette.CURATED, still what the narrow setting means), and
          that was the wrong pairing: the two features it governs are on by
          default and promise to match the app being typed in, so the narrow
          default made that promise false almost everywhere and the features
          read as broken rather than as restrained. Either way this is a
          restraint on this app's own code, not on its capability —
          a setting cannot revoke a manifest declaration. Making it provable
          would take a second build dimension, the way INTERNET did.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:localeConfig="@xml/locales_config"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.RimBoard">

        <service
            android:name=".RimBoardService"
            android:exported="true"
            android:directBootAware="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <!--
            The system spell checker: the same engine, offered to other apps so
            RimBoard's dictionaries and learned words drive the red underlines
            everywhere rather than only inside its own suggestion strip.

            A separate component, not a separate app — one APK, one install, and
            no permission beyond what is already declared above. It is inert
            until the user selects RimBoard under Settings -> Languages and
            input -> Spell checker, which is the whole of the consent step.

            Deliberately NOT directBootAware, unlike the keyboard. The keyboard
            has to run on the lock screen; a spell checker has no business
            starting before the phone has been unlocked once.
        -->
        <service
            android:name=".spell.RimSpellService"
            android:exported="true"
            android:label="@string/spell_service_label"
            android:permission="android.permission.BIND_TEXT_SERVICE">
            <intent-filter>
                <action android:name="android.service.textservice.SpellCheckerService" />
            </intent-filter>
            <meta-data
                android:name="android.view.textservice.scs"
                android:resource="@xml/spellchecker" />
        </service>

        <activity
            android:name=".setup.MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title" />

        <activity
            android:name=".settings.PersonalDictActivity"
            android:exported="false"
            android:label="@string/pref_personal_dict_title" />

        <activity
            android:name=".settings.ShortcutsActivity"
            android:exported="false"
            android:label="@string/pref_shortcuts_title" />

        <activity
            android:name=".settings.StatsActivity"
            android:exported="false"
            android:label="@string/pref_stats_title" />

        <activity
            android:name=".settings.ToolbarPickerActivity"
            android:exported="false"
            android:label="@string/pref_toolbar_title" />

        <activity
            android:name=".settings.NetworkActivity"
            android:exported="false"
            android:label="@string/pref_network_title" />

        <activity
            android:name=".settings.BackgroundCropActivity"
            android:exported="false"
            android:label="@string/pref_bg_image_title" />

    </application>

</manifest>
